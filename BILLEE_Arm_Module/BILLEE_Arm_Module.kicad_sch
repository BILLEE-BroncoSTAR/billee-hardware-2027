	(text_box "Legend GX20_pin_layout\n\nCh.A: blue wire Ch.B: Green wire\n\nLeft (4) Right (5)\n\nPin 1: CAN-H\n\nPin 2: CAN-L\n\nPin 3: Vcc (Right yellow Jacket)\n\nPin 4: GND (Left yellow Jacket)\n\nPin 5: GND (Middle yellow Jacket)\n\npin 6: GND (Right yellow Jacket)\n\npin 7: Ch.B (Right yellow Jacket)\n\npin 8: Ch.B (Left yellow Jacket)\n\npin 9: Ch.A (Left yellow Jacket)\n\npin 10: Vcc (Left yellow Jacket)\n\npin 11: Vcc (Middle yellow Jacket)\n\npin 12: Ch.A (Right yellow Jacket)\n\npin 13: Ch.B (Middle yellow Jacket)\n\npin 14: Ch.A (Middle yellow Jacket)\n\n"
		(exclude_from_sim no)
		(at 154.94 180.34 0)
		(size 39.37 69.3764)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "770b3893-4466-4584-bc37-b97725fa4ed0")
	)
	(text_box "BILLEE Mechanical Arm URC 2027\n\nThis Mechanical Arm operates on a votlage domain of +22.2V supplied by the BILLEE Rover Control Module. \nThe 1st, 2nd, and 3rd axis motors are controlled over CAN by the Jetson, the 3 yellowjackets are controlled by a Roboclaw driver ported to ROS2.\nThe external Solenoid is controlled by a Logic Level relay bound to a GPIO on the Nvidia Jetson Orin AGX."
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(size 180.34 41.9607)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 3.048 3.048)
				(thickness 0.6096)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c61273aa-f673-4c1c-8f8e-1636fa620134")
	)
