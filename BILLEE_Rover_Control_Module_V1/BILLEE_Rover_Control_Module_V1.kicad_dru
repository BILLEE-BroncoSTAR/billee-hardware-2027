(version 1)
(rule "JLCPCB 2oz outer - clearance F.Cu"
    (layer "F.Cu")
    (constraint clearance (min 0.15mm)))

(rule "JLCPCB 2oz outer - clearance B.Cu"
    (layer "B.Cu")
    (constraint clearance (min 0.15mm)))

(rule "JLCPCB 2oz outer - track width F.Cu"
    (layer "F.Cu")
    (constraint track_width (min 0.15mm)))

(rule "JLCPCB 2oz outer - track width B.Cu"
    (layer "B.Cu")
    (constraint track_width (min 0.15mm)))